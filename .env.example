# Copy this file to .env and fill in your own values.
# .env is git-ignored and should never be committed.

# --- Legal requirement: must be explicitly set to "true" ---
# By setting this to true you accept Mojang's EULA:
# https://www.minecraft.net/en-us/eula
EULA_ACCEPTED=false

# --- Minecraft server version to build (optional, has a default) ---
MINECRAFT_VERSION=1.21.1

# --- Server runtime settings (all optional, defaults shown) ---
SERVER_NAME=My Minecraft Server
DIFFICULTY=normal
MAX_PLAYERS=20
GAME_MODE=survival
SERVER_PORT=25565
MEMORY_MIN=1G
MEMORY_MAX=2G
